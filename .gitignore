# Terraform state — never commit these
.terraform/
*.tfstate
*.tfstate.backup
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files
*.tfvars
*.tfvars.json

# Portable binary (downloaded for local testing)
terraform.exe
terraform

# Terraform lock file IS intentionally committed
# .terraform.lock.hcl
